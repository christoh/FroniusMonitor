<?xml version="1.0" encoding="utf-8"?>
<Settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <FritzBoxConnections>
      <WebConnection BaseUrl="http://192.168.178.xxx" UserName="SomeName" PasswordChecksum="9M3y/STH83c=" Password="6tgm7fD/arG3fPie1xgRGQ==" />
   </FritzBoxConnections>
   <ModbusMappings>
      <ModbusMapping ModbusAddress="0" SerialNumber="" Phase="1" />
   </ModbusMappings>
   <ServerIpAddress>0.0.0.0</ServerIpAddress>
   <ServerPort>1502</ServerPort>
   <!-- Optional. How clients log in. A client exchanges its user name and password for a bearer token
        (POST api/Identity/login) and sends that token with every request; it renews the token shortly before it
        expires. The tokens are kept in the server's memory only, so a restart ends every session and the clients
        log in again by themselves. BearerTokenLifetimeMinutes is how long a token stays valid (30 by default,
        at least 1).
        EnableBasicAuthentication and EnableCookieAuthentication are for debugging and off by default.
        Basic lets a request carry the user name and password itself (Authorization: Basic), e.g. from curl.
        Cookie makes a login also set an "auth" cookie holding the token, so that after one
        api/Identity/login?user=...&password=... in the address bar the API can be called from the same browser.
        The server logs a warning at every start while either of them is on. Leave the element out for the defaults. -->
   <Authentication BearerTokenLifetimeMinutes="30" EnableBasicAuthentication="false" EnableCookieAuthentication="false" />
   <!-- Optional. The reverse proxy in front of the server (nginx, an ingress) whose X-Forwarded-For and
        X-Forwarded-Proto are believed, so that the log shows the client's address instead of the proxy's.
        A Proxy is an IP address (192.168.44.1) or a network (192.168.44.0/24), as the server sees the proxy connect:
        until it is listed here, that is the address every "from ..." in the log shows. Loopback is trusted anyway.
        Do not list more than the proxy: whoever is trusted here can choose the address they are logged under. -->
   <WebServerSettings>
      <TrustedProxies>
         <Proxy>192.168.44.1</Proxy>
      </TrustedProxies>
   </WebServerSettings>
   <!-- Optional. How often the GEN24 inverters in Gen24Connections are polled (RefreshRate, every 5 seconds by
        default) and how often each inverter's own configuration is re-read (ConfigRefreshRate, every 5 minutes by
        default), and where the energy history log file per inverter is written (LogDirectory, /var/log by default).
        RefreshRate and ConfigRefreshRate are XML duration attributes, e.g. "PT5S" (5 seconds) or "PT5M" (5 minutes). -->
   <Gen24DataCollector RefreshRate="PT5S" ConfigRefreshRate="PT5M" LogDirectory="/var/log" />
   <!-- Optional. AzureDeviceId is drawn at random and written here on the first start; do not change it afterwards.
        Session is the bearer token of the last login and is filled in by the server. -->
   <ToshibaHvac BaseUrl="https://mobileapi.toshibahomeaccontrols.com" UserName="you@example.com" ClearTextPassword="your password, replaced by an encrypted Password on the first save" AzureDeviceId="123456" MappingRefreshMinutes="30" />
   <!-- Optional. The price chart: market prices, sun and wind production and the tariff from Awattar (tado° Energy),
        the weather from the German weather service (DWD). Leave the element out to collect none of it.
        Bearer is Awattar's fixed token for the tariff query; without it (and PostalCode and GridOperatorId) the
        market prices are still collected, only the price components stay empty. It is stored in clear text.
        GridOperatorId is the 13 digit id of your grid operator (Netzbetreiber), PostalCode selects the tariff.
        SurchargeCentsPerKiloWattHour is Awattar's own service fee, which is not in their answer.
        DwdStationId is a station of the MOSMIX catalogue (https://www.dwd.de/DE/leistungen/met_verfahren_mosmix/mosmix_stationskatalog.cfg);
        10863 is Weihenstephan, which measures global radiation as well; 10870 (München-Flughafen) forecasts but does not measure it. TimeZoneId says which local time the polling windows and the days are meant in;
        a container runs in UTC unless it is set here or through TZ. The history goes to history/PriceAndWeatherHistory.db
        next to the executable; mount that folder to keep it. -->
   <EnergyData Bearer="your Awattar bearer token" PostalCode="85375" GridOperatorId="9901068000001" SurchargeCentsPerKiloWattHour="1.5" VatRatePercent="19" PriceRegion="GermanyLuxembourg" DwdStationId="10863" TimeZoneId="Europe/Berlin" />
   <!-- Optional. The history charts of Fronius Solar.web (production, consumption, and with Solar.web Premium
        earnings and costs; per day, month, year and overall), served over GET api/SolarWeb/{day|month|year|all}/{production|consumption|returnofinvestment|expense}/{yyyy-MM-dd}.
        UserName and password are the Fronius login (the e-mail address); PvSystemId is the GUID in the address of
        the system's Solar.web pages. A period that is over is read once and cached in history/SolarWebHistory.db
        next to the executable (mount that folder to keep it); charts of single days are kept for 30 days, months,
        years and the overall chart for good. A running period is read again after RefreshMinutes. Solar.web limits
        the request rate (429), so keep RefreshMinutes at 5 or more. TimeZoneId is the PV system's; it decides
        when a day is over. The firmware status of the system's components (GET api/SolarWeb/firmware) is checked
        every RefreshMinutes as well, and every change is pushed to the clients over the hub. -->
   <SolarWeb BaseUrl="https://www.solarweb.com" UserName="you@example.com" ClearTextPassword="your password, replaced by an encrypted Password on the first save" PvSystemId="00000000-0000-0000-0000-000000000000" RefreshMinutes="15" TimeZoneId="Europe/Berlin" />
</Settings>