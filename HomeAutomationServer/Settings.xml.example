<?xml version="1.0" encoding="utf-8"?>
<Settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <FritzBoxConnections>
      <WebConnection BaseUrl="http://192.168.178.xxx" UserName="SomeName" PasswordChecksum="9M3y/STH83c=" Password="6tgm7fD/arG3fPie1xgRGQ==" />
   </FritzBoxConnections>
   <ModbusMappings>
      <ModbusMapping ModbusAddress="0" SerialNumber="" Phase="1" />
   </ModbusMappings>
   <ServerIpAddress>0.0.0.0</ServerIpAddress>
   <ServerPort>1502</ServerPort>
   <!-- Optional. How often the GEN24 inverters in Gen24Connections are polled (RefreshRate, every 5 seconds by
        default) and how often each inverter's own configuration is re-read (ConfigRefreshRate, every 5 minutes by
        default), and where the energy history log file per inverter is written (LogDirectory, /var/log by default).
        RefreshRate and ConfigRefreshRate are XML duration attributes, e.g. "PT5S" (5 seconds) or "PT5M" (5 minutes). -->
   <Gen24DataCollector RefreshRate="PT5S" ConfigRefreshRate="PT5M" LogDirectory="/var/log" />
   <!-- Optional. AzureDeviceId is drawn at random and written here on the first start; do not change it afterwards.
        Session is the bearer token of the last login and is filled in by the server. -->
   <ToshibaHvac BaseUrl="https://mobileapi.toshibahomeaccontrols.com" UserName="you@example.com" ClearTextPassword="your password, replaced by an encrypted Password on the first save" AzureDeviceId="123456" MappingRefreshMinutes="30" />
   <!-- Optional. The price chart: market prices, sun and wind production and the tariff from Awattar (tado° Energy),
        the weather from the German weather service (DWD). Leave the element out to collect none of it.
        Bearer is Awattar's fixed token for the tariff query; without it (and PostalCode and GridOperatorId) the
        market prices are still collected, only the price components stay empty. It is stored in clear text.
        GridOperatorId is the 13 digit id of your grid operator (Netzbetreiber), PostalCode selects the tariff.
        SurchargeCentsPerKiloWattHour is Awattar's own service fee, which is not in their answer.
        DwdStationId is a station of the MOSMIX catalogue (https://www.dwd.de/DE/leistungen/met_verfahren_mosmix/mosmix_stationskatalog.cfg);
        10863 is Weihenstephan, which measures global radiation as well; 10870 (München-Flughafen) forecasts but does not measure it. TimeZoneId says which local time the polling windows and the days are meant in;
        a container runs in UTC unless it is set here or through TZ. The history goes to history/PriceAndWeatherHistory.db
        next to the executable; mount that folder to keep it. -->
   <EnergyData Bearer="your Awattar bearer token" PostalCode="85375" GridOperatorId="9901068000001" SurchargeCentsPerKiloWattHour="1.5" VatRatePercent="19" PriceRegion="GermanyLuxembourg" DwdStationId="10863" TimeZoneId="Europe/Berlin" />
</Settings>