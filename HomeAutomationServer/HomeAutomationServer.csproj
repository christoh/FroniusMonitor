<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyVersion>0.9.*</AssemblyVersion>
		<Configuration>Release</Configuration>
		<Deterministic>false</Deterministic>
		<Configuration>Release</Configuration>
		<InvariantGlobalization>false</InvariantGlobalization>
		<Nullable>enable</Nullable>
		<RootNamespace>De.Hochstaetter.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<NoWarn>1701;1702;IDE0079;NU1803;CS7035;CA1873</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="FluentModbus" Version="5.3.2" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<!-- The history of prices and weather is one SQLite file in the history folder; see Services/EnergyHistoryStore. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Expressions" Version="5.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="System.IO.Packaging" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="GitInfo" Version="3.6.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fronius\Fronius.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Program and its startup checks are internal; the tests exercise them where they are, rather than the
			 code being made public for their sake. -->
		<InternalsVisibleTo Include="HomeAutomationServerTests" />
	</ItemGroup>

	<!--
		Hosting the browser client (see Program.cs): the client is HomeAutomationClient.Browser, a separate
		Avalonia WebAssembly app that needs the wasm-tools workload to build. That workload is not something a
		plain build, `dotnet test`, or the cloud sandbox has any reason to require, so publishing it is opt-in
		via PublishClientApp. With PublishClientApp unset or false, these targets do nothing and this project
		builds exactly as before.

		The Dockerfile at the repository root sets it too, but it publishes the client in a stage of its own,
		which the stand-alone client image uses as well, and hands the result in: ClientAppPrePublished=true with
		ClientPublishDir pointing at it makes these targets take that output instead of publishing the client a
		second time. It also sets CopyClientWwwRoot=false, because it adds the client's wwwroot to both images as
		one and the same layer of its own; here only the manifest is copied then.
	-->
	<PropertyGroup>
		<PublishClientApp Condition="'$(PublishClientApp)' == ''">false</PublishClientApp>
		<ClientAppPrePublished Condition="'$(ClientAppPrePublished)' == ''">false</ClientAppPrePublished>
		<CopyClientWwwRoot Condition="'$(CopyClientWwwRoot)' == ''">true</CopyClientWwwRoot>
		<ClientBrowserProject>$(MSBuildThisFileDirectory)..\HomeAutomationClient\HomeAutomationClient.Browser\HomeAutomationClient.Browser.csproj</ClientBrowserProject>
		<ClientPublishDir Condition="'$(ClientPublishDir)' == ''">$(MSBuildThisFileDirectory)obj\ClientPublish\</ClientPublishDir>
	</PropertyGroup>

	<Target Name="PublishClientWebAssembly" BeforeTargets="Publish" Condition="'$(PublishClientApp)' == 'true' And '$(ClientAppPrePublished)' != 'true'">
		<Exec Command="dotnet publish &quot;$(ClientBrowserProject)&quot; -c $(Configuration) -o &quot;$(ClientPublishDir)&quot;" />
	</Target>

	<!-- AfterTargets, not a Content/CopyToPublishDirectory item: the client is published (see above), not
		 restored, so its files do not exist yet when MSBuild builds the Content item list. -->
	<Target Name="CopyClientWebAssemblyToPublishDir" AfterTargets="Publish" Condition="'$(PublishClientApp)' == 'true'">
		<ItemGroup>
			<ClientWwwRootFiles Include="$(ClientPublishDir)wwwroot\**" />
		</ItemGroup>
		<Copy SourceFiles="@(ClientWwwRootFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(CopyClientWwwRoot)' == 'true'" />

		<!-- app.MapStaticAssets() (see Program.cs) reads "<entry assembly>.staticwebassets.endpoints.json" next
			 to the running app's own dll. The Avalonia WebAssembly SDK wrote this manifest for its own assembly
			 name, so it is copied under this project's name instead of that one - the manifest itself does not
			 care, its paths are already relative to wwwroot. -->
		<Copy SourceFiles="$(ClientPublishDir)HomeAutomationClient.Browser.staticwebassets.endpoints.json" DestinationFiles="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
	</Target>

</Project>
