<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only since 2026-09-15: the tests reach into FroniusMonitor, which is WPF. -->
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Serialize the project references: FroniusMonitor may not have its XAML compiled beside its siblings.
		     See the same property in FroniusMonitor.csproj. -->
		<BuildInParallel>false</BuildInParallel>
		<Nullable>enable</Nullable>
		<!-- dotnet test runs on the Microsoft Testing Platform (global.json), which needs an executable and the
		     NUnit runner for it; without both the project is refused. -->
		<OutputType>Exe</OutputType>
		<EnableNUnitRunner>true</EnableNUnitRunner>

		<IsPackable>false</IsPackable>
		<NoWarn>1701;1702;IDE0079;NU1803;CS7035;NU1900</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
		<PackageReference Include="NSubstitute" Version="6.2.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Expressions" Version="5.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="System.IO.Packaging" Version="10.0.12" />
		<PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fronius\Fronius.csproj" />
		<ProjectReference Include="..\FroniusMonitor\FroniusMonitor.csproj" />
	</ItemGroup>

</Project>
