<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only since 2026-09-15: the validation tests reach into FroniusMonitor, which is WPF. -->
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Serialize the project references: FroniusMonitor may not have its XAML compiled beside its siblings.
		     See the same property in FroniusMonitor.csproj. -->
		<BuildInParallel>false</BuildInParallel>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- xUnit v3 test projects are executables. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>De.Hochstaetter.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<NoWarn>1701;1702;IDE0079;NU1803;CS7035;NU1900</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- The tests host a real Kestrel + SignalR server in process. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- The client is an Avalonia application, and the tests of its presenters and controls drive real windows
		     on the headless platform. See UnitTests/Avalonia/HeadlessAvalonia.cs. -->
		<PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
		<!-- The oracle of JsonExtensionsTests: the same JSON goes through Newtonsoft and System.Text.Json and the
		     two answers are compared. It is the only thing left in the repository that uses Newtonsoft. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="xunit.v3" Version="4.0.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HomeAutomationServer\HomeAutomationServer.csproj" />
		<!-- The view models of the client hold real logic - the interlocks and the validation of a settings tab -
		     and so do its presenters and controls, which need an Avalonia application and real windows; the headless
		     platform provides both. -->
		<ProjectReference Include="..\HomeAutomationClient\HomeAutomationClient\HomeAutomationClient.csproj" />
		<!-- RegexRuleAttribute lives in the WPF app, because nothing but it and these tests uses it. That is what
		     makes this project Windows only. -->
		<ProjectReference Include="..\FroniusMonitor\FroniusMonitor.csproj" />
	</ItemGroup>

</Project>
