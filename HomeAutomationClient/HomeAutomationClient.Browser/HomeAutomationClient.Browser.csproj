<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<OutputType>Exe</OutputType>
		<Configuration>Release</Configuration>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>De.Hochstaetter.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<!-- The WebAssembly SDK compiles ahead of time only with IL trimming on. Partial trims the assemblies that declare
		     themselves trimmable - the framework, Avalonia, SkiaSharp, the SignalR client, the toolkit - and leaves the
		     rest whole: Fronius, this client, ScottPlot, the DataGrid. That is the mode the mobile heads build with, and
		     it is what the reflection in our code counts on; see PlatformHeads.Lifecycle and Dashboard.Loading. -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<!-- A trimmed app has System.Text.Json's reflection-based serialization switched off by default, and the app then
		     dies on its first JSON - the cache read at start-up. The web client, the hub protocol and the caches serialize
		     our models with it, and those types are untrimmed, so it is switched back on. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<Nullable>enable</Nullable>
        <WasmBuildNative>true</WasmBuildNative>
		<!-- Compiled to WebAssembly ahead of time when published, which is what the Dockerfile does. Without this the
		     app runs in Mono's interpreter, which is several times slower on the work a page like the dashboard is
		     made of - building a few thousand controls and bindings - than the JIT the desktop head has. The publish
		     takes longer and the download is bigger; the wasm-tools workload the AOT compiler needs is already
		     installed in the client builder stage. A plain build or dotnet run does not compile ahead of time. -->
		<RunAOTCompilation>true</RunAOTCompilation>
		<UserSecretsId>fd7e4816-270f-4bb3-9abf-bec39a784410</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HomeAutomationClient\HomeAutomationClient.csproj" />
	</ItemGroup>
</Project>
