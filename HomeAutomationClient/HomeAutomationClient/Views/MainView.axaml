<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:De.Hochstaetter.HomeAutomationClient.ViewModels"
             xmlns:co="clr-namespace:De.Hochstaetter.HomeAutomationClient.Converters"
             xmlns:li="clr-namespace:De.Hochstaetter.HomeAutomationClient.Assets.LoadingIndicators.Avalonia"
             xmlns:c="clr-namespace:De.Hochstaetter.HomeAutomationClient.Controls"
             xmlns:p="clr-namespace:De.Hochstaetter.Fronius.Localization;assembly=Fronius"
             xmlns:services="clr-namespace:De.Hochstaetter.HomeAutomationClient.Services"
             xmlns:models="clr-namespace:De.Hochstaetter.HomeAutomationClient.Models"
             xmlns:views="clr-namespace:De.Hochstaetter.HomeAutomationClient.Views"
             xmlns:contracts="clr-namespace:De.Hochstaetter.HomeAutomationClient.Contracts"
             xmlns:gen24="clr-namespace:De.Hochstaetter.Fronius.Models.Gen24;assembly=Fronius"
             xmlns:i="clr-namespace:De.Hochstaetter.HomeAutomationClient.Assets.Images"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="De.Hochstaetter.HomeAutomationClient.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Background="{DynamicResource MenuBackground}" IsVisible="{Binding IsReady}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <ControlTemplate TargetType="Button" x:Key="MenuButtonTemplate">
                        <ContentPresenter Padding="8" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                    <ControlTheme TargetType="Button" x:Key="MenuButtonStyle">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template" Value="{StaticResource MenuButtonTemplate}"/>
                    </ControlTheme>
                </StackPanel.Resources>
                <StackPanel.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}"/>
                    </Style>
                </StackPanel.Styles>
                <Button Content="{x:Static p:Resources.Dashboard}" Theme="{StaticResource MenuButtonStyle}" Command="{Binding ShowDashboardCommand}"/>
                <Button Content="{x:Static p:Resources.Details}" x:Name="DetailsButton" Theme="{StaticResource MenuButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding UpdateService.DetailDevices}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="{x:Type contracts:IKeyedDevice}">
                                    <Setter Property="Header" Value="{Binding TargetNullValue={x:Static p:Resources.Unknown}}"/>
                                    <Setter Property="Command" Value="{ReflectionBinding ((vm:MainViewModel)DataContext)?.ShowDetailsCommand, ElementName=DetailsButton}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                    <Setter Property="Padding" Value="8,12"/>
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="{x:Static p:Resources.Settings}" Theme="{StaticResource MenuButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding SettingsItems}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="{x:Type x:Object}">
                                    <Setter Property="Header" Value="{Binding TargetNullValue={x:Static p:Resources.Unknown}}"/>
                                    <Setter Property="Command" Value="{ReflectionBinding ((vm:MainViewModel)DataContext)?.SettingsCommand, ElementName=DetailsButton}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                    <Setter Property="Padding" Value="8,12"/>
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <!-- Who is logged in, and as what. The roles are the server's enum names on purpose, not translated. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0" Spacing="6">
                <i:UserIcon Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UserText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <UserControl Grid.Row="1" Content="{Binding MainViewContent}" IsEnabled="{Binding IsModalDialogVisible, Converter={co:BoolInverter}}"/>

        <!-- Applies to the gauges of every view, so it lives here and not in one of them. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24" Margin="16,8" IsVisible="{Binding IsReady}"
                    IsEnabled="{Binding IsModalDialogVisible, Converter={co:BoolInverter}}">
            <ToggleButton Classes="OnOff Labeled" Height="16" VerticalAlignment="Center" IsChecked="{Binding ColorAllTicks}"
                          Content="{x:Static p:Resources.ColorAllGaugeTicks}" />
            <!-- Overrides the light/dark variant the OS or browser reported; see MainViewModel.IsDarkMode. -->
            <ToggleButton Classes="OnOff Labeled" Height="16" VerticalAlignment="Center" IsChecked="{Binding IsDarkMode}"
                          Content="{x:Static p:Resources.DarkMode}" />
        </StackPanel>
        <c:BusyAnimation BusyText="{Binding BusyText}" Grid.Row="1"/>
        <!-- Dims the views behind a modal dialog and swallows their pointer input. A non-modal dialog leaves it out,
        so that clicks reach the view behind: a panel without a background does not take part in hit testing. -->
        <Grid Grid.Row="1" Background="{DynamicResource DisableBrush}" IsVisible="{Binding IsModalDialogVisible}"/>
        <Grid Grid.Row="1" x:Name="DialogOverlay" IsVisible="{Binding IsDialogVisible}">
            <Grid x:Name="DialogFrame" RowDefinitions="Auto,*" Background="{DynamicResource DialogBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid ZIndex="2" ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                      c:DragMove.Target="{Binding #DialogFrame}"
                      c:DragMove.ResetTrigger="{Binding CurrentDialog}"
                      c:DragMove.IsEnabled="{Binding CurrentDialog.Parameters.IsMoveable, FallbackValue=False}">
                    <Grid.Styles>
                        <Style Selector="Button.CloseButton">
                            <Style.Resources>
                                <!-- ReSharper disable Xaml.RedundantResource -->
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver">Red</SolidColorBrush>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                                <!-- ReSharper restore Xaml.RedundantResource -->
                            </Style.Resources>
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}"/>
                            <Setter Property="Content" Value="X" />
                            <Setter Property="Command" Value="{Binding DialogClosedCommand}"/>
                            <!-- Cursor is inherited, and the title bar is a drag handle, so without this the close
                                 box offers to move the dialog instead of to close it. -->
                            <Setter Property="Cursor" Value="Arrow" />
                        </Style>
                    </Grid.Styles>
                    <Image Margin="4,0,0,0" Source="/Assets/Images/sun.ico" Width="16"/>
                    <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Grid.Column="1" Padding="5" Text="{Binding CurrentDialog.Title, FallbackValue=''}" Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
                    <Button Classes="TransparentButton CloseButton" Grid.Row="0" Grid.Column="2" IsTabStop="False" IsVisible="{Binding CurrentDialog.Parameters.ShowCloseBox, FallbackValue=True}"/>
                </Grid>
                <UserControl Grid.Row="1" ZIndex="2" MinWidth="100" Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource ForegroundBrush}" x:Name="DialogHost" Content="{Binding CurrentDialog.Body, FallbackValue={x:Null}}"/>

                <!-- The resize grip, for a dialog that asks for one. It resizes the body rather than this frame,
                     because the body is what decides how big the dialog is - see DragResize. ZIndex above the
                     body, or whatever the dialog puts in its bottom right corner would take the drag.

                     The drag is on the panel and not on the lines drawn in it: a stroked Path is hit only along
                     its stroke, so the grip would have to be grabbed by a one pixel diagonal. A transparent
                     background takes part in hit testing where no background at all does not, so the panel gives
                     the whole corner to the pointer. -->
                <Panel Grid.Row="1" ZIndex="4" Width="18" Height="18" Background="Transparent" x:Name="ResizeGrip"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       IsVisible="{Binding CurrentDialog.Parameters.IsResizeable, FallbackValue=False}"
                       c:DragResize.Target="{Binding #DialogHost.Content}"
                       c:DragResize.Anchor="{Binding #DialogFrame}"
                       c:DragResize.ResetTrigger="{Binding CurrentDialog}"
                       c:DragResize.IsEnabled="{Binding CurrentDialog.Parameters.IsResizeable, FallbackValue=False}">
                    <Path Width="12" Height="12" Margin="0,0,3,3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1" Opacity="0.5"
                          Data="M 11,1 L 1,11 M 11,5 L 5,11 M 11,9 L 9,11" />
                </Panel>
                <!-- A non-modal dialog must stay operable, so it never gets the blocking busy overlay. -->
                <c:BusyAnimation ZIndex="3" Grid.Row="1" BusyText="{Binding DialogBusyText}" IsVisible="{Binding IsModalDialogVisible}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>