<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="De.Hochstaetter.HomeAutomationClient.Views.SmartMeterDetailsView"
             xmlns:vm="clr-namespace:De.Hochstaetter.HomeAutomationClient.ViewModels"
             xmlns:c="clr-namespace:De.Hochstaetter.HomeAutomationClient.Controls"
             xmlns:p="clr-namespace:De.Hochstaetter.Fronius.Localization;assembly=Fronius"
             xmlns:co="clr-namespace:De.Hochstaetter.HomeAutomationClient.Converters"
             xmlns:m="clr-namespace:De.Hochstaetter.HomeAutomationClient.Misc"
             x:DataType="{x:Type vm:SmartMeterDetailsViewModel}"
             >
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding UpdateService.SmartMeter?.Model}" TextAlignment="Center" FontSize="18" FontWeight="Medium" Margin="10,10,10,16" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- ReSharper disable Xaml.PossibleNullReferenceException -->
            <WrapPanel Orientation="Horizontal" Margin="10,0,4,0" Classes="GaugeGroups">
                <WrapPanel.Styles>
                    <Style Selector="c|HalfCircleGauge">

                        <!-- The shared DetailsGauge template paints the gauge Background, so the meter status is evaluated here. -->
                        <Setter Property="Background">
                            <Setter.Value>
                                <MultiBinding Converter="{co:InverterBackgroundColor}">
                                    <Binding Path="UpdateService.MeterStatus?.StatusCode" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </WrapPanel.Styles>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.ActivePower}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="W" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsGood}" />
                                <Setter Property="Minimum" Value="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsMinimum=True, IsOnePhase=True}, FallbackValue=-8050}" />
                                <Setter Property="Maximum" Value="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsOnePhase=True}, FallbackValue=8050}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.ActivePowerL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.ActivePowerL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.ActivePowerL3}" />

                        <c:HalfCircleGauge Label="{x:Static p:Resources.Sum}"
                                           Minimum="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsMinimum=True}, FallbackValue=-24150}"
                                           Maximum="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter}, FallbackValue=24150}"
                                           Value="{Binding UpdateService.SmartMeter?.ActivePowerSum}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.ApparentPower}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="VA" />
                                <Setter Property="Minimum" Value="0" />
                                <Setter Property="Origin" Value="0" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.HighIsBad}" />
                                <Setter Property="Maximum" Value="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsOnePhase=True}, FallbackValue=8050}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.ApparentPowerL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.ApparentPowerL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.ApparentPowerL3}" />

                        <c:HalfCircleGauge Label="{x:Static p:Resources.Sum}"
                                           Maximum="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter}, FallbackValue=24150}"
                                           Value="{Binding UpdateService.SmartMeter?.ApparentPowerSum}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.ReactivePower}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="VA(r)" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsGood}" />
                                <Setter Property="Minimum" Value="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsMinimum=True, IsOnePhase=True}, FallbackValue=-8050}" />
                                <Setter Property="Maximum" Value="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsOnePhase=True}, FallbackValue=8050}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.ReactivePowerL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.ReactivePowerL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.ReactivePowerL3}" />

                        <c:HalfCircleGauge Label="{x:Static p:Resources.Sum}"
                                           Minimum="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter IsMinimum=True}, FallbackValue=-24150}"
                                           Maximum="{Binding UpdateService.PrimaryGen24Config?.InverterSettings?.PowerLimitSettings?.ExportLimits, Converter={co:StrictestLimitConverter}, FallbackValue=24150}"
                                           Value="{Binding UpdateService.SmartMeter?.ReactivePowerSum}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="cos(ϕ)">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="Minimum" Value="-1" />
                                <Setter Property="Maximum" Value="1" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="ValueStringFormat" Value="N3" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsBad}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.PowerFactorL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.PowerFactorL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.PowerFactorL3}" />
                        <c:HalfCircleGauge Label="{x:Static p:Resources.Total}" Value="{Binding UpdateService.SmartMeter?.PowerFactorTotal}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.PhaseVoltage}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="V" />
                                <Setter Property="Minimum" Value="207" />
                                <Setter Property="Maximum" Value="253" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsGood}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.PhaseVoltageL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.PhaseVoltageL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.PhaseVoltageL3}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.LineVoltage}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="V" />
                                <Setter Property="Minimum" Value="358.5345171668" />
                                <Setter Property="Maximum" Value="438.2088543149" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsGood}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L12" Value="{Binding UpdateService.SmartMeter?.LineVoltageL12}" />
                        <c:HalfCircleGauge Label="L23" Value="{Binding UpdateService.SmartMeter?.LineVoltageL23}" />
                        <c:HalfCircleGauge Label="L31" Value="{Binding UpdateService.SmartMeter?.LineVoltageL31}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.Frequency}">
                    <StackPanel Orientation="Horizontal">
                        <!-- N1, not the inverter's N3: the smart meter reports the frequency with less precision. -->
                        <c:HalfCircleGauge Label="{x:Static p:Resources.Grid}" UnitName="Hz"
                                           Minimum="49.8" Maximum="50.2" Origin=".5"
                                           ValueStringFormat="N1" StringFormat="N1"
                                           GaugeColors="{x:Static m:GaugeColors.MidIsGood}"
                                           Value="{Binding UpdateService.SmartMeter?.Frequency}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.Current}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="A" />
                                <Setter Property="ValueStringFormat" Value="N3" />
                                <Setter Property="Minimum" Value="-35" />
                                <Setter Property="Maximum" Value="35" />
                                <Setter Property="Origin" Value=".5" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.MidIsGood}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L1" Value="{Binding UpdateService.SmartMeter?.CurrentL1}" />
                        <c:HalfCircleGauge Label="L2" Value="{Binding UpdateService.SmartMeter?.CurrentL2}" />
                        <c:HalfCircleGauge Label="L3" Value="{Binding UpdateService.SmartMeter?.CurrentL3}" />
                        <c:HalfCircleGauge Label="{x:Static p:Resources.Sum}" Minimum="-105" Maximum="105"
                                           Value="{Binding UpdateService.SmartMeter?.TotalCurrent}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="GroupBox" Header="{x:Static p:Resources.OutOfBalance}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Styles>
                            <Style Selector="c|HalfCircleGauge">
                                <Setter Property="UnitName" Value="A" />
                                <Setter Property="ValueStringFormat" Value="N3" />
                                <Setter Property="Minimum" Value="0" />
                                <Setter Property="Maximum" Value="16" />
                                <Setter Property="Origin" Value="0" />
                                <Setter Property="GaugeColors" Value="{x:Static m:GaugeColors.HighIsBad}" />
                            </Style>
                        </StackPanel.Styles>

                        <c:HalfCircleGauge Label="L12" Value="{Binding UpdateService.SmartMeter?.OutOfBalanceCurrentL12}" />
                        <c:HalfCircleGauge Label="L23" Value="{Binding UpdateService.SmartMeter?.OutOfBalanceCurrentL23}" />
                        <c:HalfCircleGauge Label="L31" Value="{Binding UpdateService.SmartMeter?.OutOfBalanceCurrentL31}" />
                    </StackPanel>
                </HeaderedContentControl>
                <!-- ReSharper restore Xaml.PossibleNullReferenceException -->
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</ContentPage>
