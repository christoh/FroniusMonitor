<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:De.Hochstaetter.Fronius.Localization;assembly=Fronius"
             xmlns:dialogs="clr-namespace:De.Hochstaetter.HomeAutomationClient.ViewModels.Dialogs"
             xmlns:c="clr-namespace:De.Hochstaetter.HomeAutomationClient.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="De.Hochstaetter.HomeAutomationClient.Views.Dialogs.UserEditorView"
             x:DataType="dialogs:UserEditorViewModel" MaxWidth="400" MinWidth="300">
	<StackPanel Margin="16" HorizontalAlignment="Stretch">
		<StackPanel.Styles>
			<Style Selector="StackPanel.InputBlock">
				<Setter Property="MinHeight" Value="75" />
			</Style>
		</StackPanel.Styles>

		<StackPanel Classes="InputBlock">
			<TextBlock Text="{x:Static p:Resources.Username}" />
			<TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding IsNew}" />
		</StackPanel>

		<StackPanel Classes="InputBlock">
			<TextBlock Text="{x:Static p:Resources.Password}" />
			<c:PasswordBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
			<TextBlock Text="{x:Static p:Resources.KeepPasswordHint}" Opacity="0.75" FontSize="12" IsVisible="{Binding !IsNew}" />
		</StackPanel>

		<StackPanel Classes="InputBlock">
			<TextBlock Text="{x:Static p:Resources.RepeatPassword}" />
			<c:PasswordBox Text="{Binding RepeatPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
		</StackPanel>

		<TextBlock Text="{x:Static p:Resources.Roles}" />
		<ItemsControl ItemsSource="{Binding RoleItems}" Margin="0,4,0,16">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="dialogs:RoleItem">
					<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Content="{x:Static p:Resources.Ok}" Command="{Binding OkCommand}" />
			<Button IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" Content="{x:Static p:Resources.Cancel}" Command="{Binding CancelCommand}" />
		</StackPanel>
	</StackPanel>
</UserControl>