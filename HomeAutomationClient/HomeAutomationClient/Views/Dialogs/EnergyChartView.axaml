<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:De.Hochstaetter.Fronius.Localization;assembly=Fronius"
             xmlns:dialogs="clr-namespace:De.Hochstaetter.HomeAutomationClient.ViewModels.Dialogs"
             xmlns:co="clr-namespace:De.Hochstaetter.HomeAutomationClient.Converters"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="520"
             x:Class="De.Hochstaetter.HomeAutomationClient.Views.Dialogs.EnergyChartView"
             x:DataType="dialogs:EnergyChartViewModel"
             Width="1000" Height="520" MinWidth="520" MinHeight="320" FontSize="12">
	<!-- The size is stated here, as the dialog system wants it, and the dialog is resizeable: a chart is the one
	     thing that gets better with every pixel the user gives it, so the grip is on from the start. The WPF window
	     opened at 1280 by 550; 1000 fits a laptop beside the dialog frame. -->
	<UserControl.Styles>
		<StyleInclude Source="avares://HomeAutomationClient/Styles/CompactForms.axaml" />
		<Style Selector="RadioButton.Wrap">
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
		<Style Selector="Button.Step">
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="*,Auto">
		<Panel Grid.Row="0">
			<!-- The chart itself. It has no bindings: the code behind draws ChartModel into it, because drawing is
			     the one thing here that needs the charting library, and reacts to the theme the same way. -->
			<sp:AvaPlot x:Name="Plot" />

			<!-- What is missing, in the top left corner over the chart, the way the WPF window wrote its errors over
			     the plot. Red at 60 %, so that it reads as a note and not as a failure of the whole dialog. -->
			<ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}" Margin="70,40,0,0"
			              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="x:String">
						<TextBlock Text="{Binding}" Foreground="#A0FF0000" FontSize="13" TextWrapping="Wrap" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Panel>

		<!-- The settings row of the WPF window: which price, with or without VAT, which day, and the two things the
		     WPF chart did not have - the weather and a way to leave the productions out - as switches. -->
		<Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16,6,16,10"
		      IsEnabled="{Binding IsBusy, Converter={co:BoolInverter}}">
			<StackPanel Grid.Column="0" Margin="0,0,16,0">
				<RadioButton Classes="Wrap" GroupName="Price" Content="{x:Static p:Resources.BuyingPrice}" IsChecked="{Binding IsBuyingPrice, Mode=TwoWay}" />
				<RadioButton Classes="Wrap" GroupName="Price" Content="{x:Static p:Resources.MarketPrice}" IsChecked="{Binding IsMarketPrice, Mode=TwoWay}" />
			</StackPanel>

			<StackPanel Grid.Column="1" Margin="0,0,16,0">
				<RadioButton Classes="Wrap" GroupName="Vat" Content="{x:Static p:Resources.WithoutVat}" IsChecked="{Binding IsNet, Mode=TwoWay}" />
				<RadioButton Classes="Wrap" GroupName="Vat" Content="{x:Static p:Resources.WithVat}" IsChecked="{Binding IsGross, Mode=TwoWay}" />
			</StackPanel>

			<StackPanel Grid.Column="2" Margin="0,0,16,0">
				<RadioButton Classes="Wrap" GroupName="Day" Content="{x:Static p:Resources.Today}" IsChecked="{Binding IsToday, Mode=TwoWay}" />
				<RadioButton Classes="Wrap" GroupName="Day" Content="{x:Static p:Resources.Tomorrow}" IsChecked="{Binding IsTomorrow, Mode=TwoWay}" />
				<RadioButton Classes="Wrap" GroupName="Day" Content="{x:Static p:Resources.Historic}" IsChecked="{Binding IsHistoric, Mode=TwoWay}" />
			</StackPanel>

			<!-- The day of the history: a picker and a step to either side, enabled only while Historic is the day
			     shown, as the WPF window has it. A DatePicker and not a CalendarDatePicker on purpose: the latter
			     has a text box the user can type into, and the interaction rule wants a typed date bound to a
			     string of the view model's. This one is spun, never typed, so it may bind the date itself. -->
			<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0"
			            IsEnabled="{Binding IsHistoric}">
				<Button Classes="Step" Content="&lt;" Command="{Binding PreviousDayCommand}" />
				<DatePicker SelectedDate="{Binding HistoricDate, Mode=TwoWay}" MinHeight="22" VerticalAlignment="Center" />
				<Button Classes="Step" Content="&gt;" Command="{Binding NextDayCommand}" />
			</StackPanel>

			<StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Center">
				<ToggleButton Classes="OnOff Labeled" Height="16" HorizontalAlignment="Left" Content="{x:Static p:Resources.WindSolar}" IsChecked="{Binding ShowProductions}" />
				<ToggleButton Classes="OnOff Labeled" Height="16" HorizontalAlignment="Left" Content="{x:Static p:Resources.WeatherDwd}" IsChecked="{Binding ShowWeather}" />
			</StackPanel>

			<Button Grid.Column="5" MinWidth="70" VerticalAlignment="Center" HorizontalContentAlignment="Center"
			        Content="{x:Static p:Resources.PriceComponents}" Command="{Binding ShowPriceComponentsCommand}" />
		</Grid>
	</Grid>
</UserControl>
