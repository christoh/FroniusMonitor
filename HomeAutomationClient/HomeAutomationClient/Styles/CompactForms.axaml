<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- The metrics the Fluent slider template reads. A slider is the one control here that cannot be scaled or
	     styled shorter - see the Slider rule below - but it does look these up, so this is where a slider of the
	     size a dense form wants comes from: a 12 pixel high control with a hairline track and a small upright
	     thumb, instead of 50 pixels with a 20 pixel disc. -->
	<Styles.Resources>
		<x:Double x:Key="SliderHorizontalHeight">18</x:Double>

		<!-- Round, so the two are the same number. 14 is the size the dot of a radio button ends up at once its
		     Viewbox has scaled it - 20 at 22 of 32 - which is what makes a slider and a radio button look like
		     they belong to the same form. -->
		<x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
		<x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>

		<x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
		<GridLength x:Key="SliderPreContentMargin">0</GridLength>
		<GridLength x:Key="SliderPostContentMargin">0</GridLength>
	</Styles.Resources>

	<!-- Density for a settings dialog. Fluent sizes its controls for a finger: a 32 pixel high combo box and a 48
	     pixel tab header. The settings views of FroniusMonitor are dense forms of thirty or forty fields, and the
	     ones still to be ported are the big ones, so a dialog that shows them needs the size WPF gives them.

	     Included by the control that wants it, never in App.axaml: the rest of the app is a touch surface and is
	     meant to keep the Fluent sizes. Everything here is a MinHeight and a Padding, so a control that needs more
	     room than the text in it - a wrapping caption, a taller font - still gets it. -->
	<Design.PreviewWith>
		<Border Padding="20" Background="{DynamicResource DialogBackground}">
			<StackPanel Width="260" Spacing="4">
				<TextBox Text="a text box" />
				<ComboBox SelectedIndex="0">
					<ComboBoxItem>a combo box</ComboBoxItem>
				</ComboBox>
				<CheckBox Content="a check box" />
				<Button Content="a button" />
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<!-- Fluent gives a tab header 24 point type and 48 pixels of height, which is a pivot on a phone rather than a
	     tab in a dialog. 16 is what the dialog itself asked for before this file existed. -->
	<!-- The height and the horizontal-only padding are what keep the bar of the selected tab off the caption.
	     The bar is bottom anchored inside the template, with a margin and a height of its own that a style setter
	     cannot change - a value set in a template wins, the same rule as the check box height below - and it sits
	     inside the padding, so padding at the bottom lifts the bar twice as far as it lifts the text and makes
	     matters worse. Only the two together decide it, and measured they decide it like this:

	         clearance = (height - vertical padding - line height) / 2 - 4

	     At 16 point the line height is 18, so 28 pixels with a padding of 2 gave -1: the line box of
	     "Energy flow" ran from 5 to 23 while the bar began at 22, which is what put it through the g and the y.
	     30 pixels with no vertical padding gives 2. -->
	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Padding" Value="10,0" />
	</Style>

	<!-- The padding is horizontal only and the content is centred, so that the number in a box lines up with the
	     caption beside it. Measured: with a padding of 6,1 the text of the box sat 2 pixels above the text of the
	     caption, because the box gives its text a line box of its own inside the padding rather than centring
	     it. -->
	<Style Selector="TextBox">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="3,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="8,1" />
	</Style>

	<!-- The item template of a combo box is not below the combo box in the tree, so it needs a rule of its own. -->
	<Style Selector="ComboBoxItem">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="8,2" />
	</Style>

	<!-- Buttons keep the height FroniusMonitor gives them, 30 - they are the one thing in a dialog that is aimed
	     at rather than read, so they are not squeezed with the fields.

	     The height comes from the padding and not from a MinHeight, which is not a detail: a MinHeight leaves the
	     content presenter stretched over the spare room, and the caption then draws at the top of it rather than
	     in the middle of the button. Measured, with 12 point type: MinHeight 30 with 2 of padding gives a 24 high
	     text block sitting 3 from the top, 7 of padding gives a 14 high one with 8 above and 8 below. It also
	     means the button follows the type: a bigger font or a caption that wraps still centres. -->
	<Style Selector="Button">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="10,7" />
	</Style>

	<!-- A check box cannot be told to be shorter: the Fluent template puts Height="32" on a grid inside itself,
	     bound to nothing the control exposes, and a style setter loses to a value set in a template. So it is
	     scaled instead - `<Viewbox Classes="CheckBox"><CheckBox ... /></Viewbox>`.

	     Used directly in a view only for a check box with no caption at all - the seven days of a charging rule's
	     schedule and the "Active" column beside them, in Gen24SelfConsumptionView, seven fixed glyphs with
	     nothing to wrap, where shrinking the whole thing uniformly is exactly what a column 126 pixels wide
	     wants. Every check box with a caption uses CheckBox.Wrap below instead, which still scales its glyph
	     with this exact same Viewbox - only nested inside its own Template, rather than around the caption too.

	     A Viewbox scales everything in it, the caption included, so the check box is given a font big enough to
	     land back at the size of the form once it has been scaled down. The two numbers below belong together:
	     change one and the caption no longer matches the rest of the dialog. They were measured, not calculated -
	     the natural height of a check box is not its box but whichever of the box and the caption is taller. -->
	<Style Selector="Viewbox.CheckBox">
		<Setter Property="Height" Value="22" />
		<Setter Property="StretchDirection" Value="DownOnly" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<Style Selector="Viewbox.CheckBox > CheckBox">
		<Setter Property="FontSize" Value="17.5" />
	</Style>

	<!-- A check box with nothing beside it, in a column of its own under a heading. Fluent lays one out 28 wide
	     whether or not it has any content - a box of 20 and a content presenter 8 to its right - so centring the
	     control leaves the box 4 to the left of centre. The 8 is not a resource, unlike the metrics of a slider:
	     it is a margin inside the template, which nothing can style. Taking it off the layout instead leaves the
	     control alone and tells the layout what the box actually occupies, and the box then centres exactly. -->
	<Style Selector="CheckBox.NoContent">
		<Setter Property="Margin" Value="0,0,-8,0" />
	</Style>

	<!-- Every check box that carries a caption uses Classes="Wrap" - the default for one with a caption, not an
	     exception for the long ones. Most captions here are read from the inverter's own translation
	     (`{l:Config '...'}`), which the app does not control and cannot assume stays short: what looked like a
	     short key name still turned out to be a long German sentence once actually shown - see
	     EXPORTLIMIT.failSafeModeEnabled below - and there is no way to tell which of the rest will do the same in
	     some other language or some other firmware. `Viewbox.CheckBox` above is kept only for the seven
	     content-less schedule glyphs, which have no caption to get wrong.

	     A Viewbox cannot be rescued for this: it measures its child unconstrained, so a caption inside one never
	     wraps no matter how little width the Viewbox is finally given - it just reports one long line and the
	     Viewbox scales the WHOLE thing, box and caption together, down until that line fits, which is what
	     shrank a caption to a few illegible points instead of letting it wrap. Forcing the wrap with a narrower
	     MaxWidth on the check box inside does not fix it either - measured - because a wrapped, multi-line child
	     is much taller, which changes the aspect ratio the Viewbox scales by, so the SAME Height="22" then
	     shrinks the glyph itself down to a few pixels instead of the caption.

	     So this Template keeps the box and the caption apart instead. The glyph is the SAME small Viewbox as
	     every other check box - untouched, so it is exactly the same size regardless of how the caption wraps -
	     around a second, undisplayed check box that exists only to draw it. The caption is a plain, wrapping
	     ContentPresenter beside it that the Viewbox never touches. The outer element is still the real CheckBox
	     the view binds to and only its Template differs, so every bit of its native behaviour - click, Tab,
	     Space, Command - keeps working. The inner check box and the caption are IsHitTestVisible="False" and the
	     inner one is besides Focusable="False", so a click or a Tab always reaches the real, outer check box
	     wherever in the row it lands, including under a wrapped caption's second line - the Grid's own
	     Background is what makes that empty looking space still count as "in the row". Measured against both a
	     short and a very long caption: the glyph stays 22 high either way, and clicking far from it, or
	     Tab-focusing the row and pressing Space, both still work. -->
	<Style Selector="CheckBox.Wrap">
		<!-- Fluent gives CheckBox a MinHeight of its own, independent of what its Template actually needs - a
		     plain Style Setter cannot shrink the default template below it, and it does not go away just because
		     this one supplies its own Template instead: measured, the row still came out 32 without this. -->
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,*" Background="Transparent">
					<!-- VerticalAlignment="Top" on the glyph, not the default it would otherwise fall back to:
					     Viewbox.CheckBox has an explicit Height, so Stretch cannot size it to the row and Avalonia
					     centres it instead - fine for a single line, but for a caption that wraps to two or three
					     it left the glyph floating between them rather than beside the first one. Measured before
					     this: in a row wrapped to three lines, the glyph's own centre sat 25 pixels below the
					     centre of the first line; with Top it lines up with it, the same as a single line check
					     box already does by having nothing else to centre against. -->
					<Viewbox Grid.Column="0" Classes="CheckBox" VerticalAlignment="Top" IsHitTestVisible="False">
						<CheckBox Classes="NoContent" IsChecked="{TemplateBinding IsChecked}"
						          IsHitTestVisible="False" Focusable="False" />
					</Viewbox>
					<!-- Top, with a fixed top margin, not Center: Center was tried first and fixed a single line
					     caption (measured 0 pixels off, against 7.1 too high with plain Top) but only by
					     accident - it centres the caption's own whole height against the row, which is the same
					     thing as centring its one line for a single line caption, but for a caption that wraps to
					     two or more lines it centres the WHOLE block instead of just the first line, which is the
					     one actually beside the glyph. Measured on a wrapped caption with Center: the first line's
					     own centre sat 4.25 pixels above the glyph's, because the second and later lines pull the
					     centre of the whole block down past where the first line alone would put it - visibly too
					     high again, just a smaller version of the original bug, and the more lines it wraps to the
					     worse it gets, not better.

					     A fixed top margin fixes both at once, because it does not care how many lines follow:
					     Top anchors the caption's first line at a constant distance below the row's own top,
					     which is also where the glyph starts, so the same margin lines the first line up with
					     the glyph's centre whether that first line is the only one or not. Measured against both
					     a single line caption and one wrapped to two lines: the glyph's centre is at 11 (a 22
					     high Viewbox), a 12 point line is 13 high, so 4.5 of margin puts the first line's centre
					     at 4.5 + 6.5 = 11 exactly, for either one.

					     4.5 and not a whole number, because 4.5 is exactly where Center had put a single line
					     caption - (22 - 13) / 2 - and that was the one placement the developer had called
					     perfect. 5 was tried first and was visibly too low on the developer's screen. A headless
					     probe at 100% reports 4.5 as half a pixel high and 5 as half a pixel low, because at that
					     scale the caption's top has to be a whole pixel and a 13 high line cannot centre on 11;
					     on a high DPI screen the layout rounds to a fraction of a pixel and 4.5 lands where the
					     arithmetic says. Do not "fix" the probe's -0.5 by going back to 5.

					     4.5, not the 8 an isolated test control first suggested: an isolated CheckBox.Wrap, built
					     outside any real view to try candidate margins quickly, measured its own glyph's centre
					     3.5 pixels lower than the same glyph reads inside the real dialog, for a reason not
					     tracked down - so 8 looked right in isolation and put every caption in the real dialog
					     3.5 pixels too low once actually checked there. The lesson: a synthetic probe is fine for
					     comparing two settings against each other, but the one number that decides where a pixel
					     actually lands has to be measured in the real view, not an approximation of it. -->
					<ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="4,4.5,0,0"
					                  VerticalAlignment="Top" TextBlock.TextWrapping="Wrap" IsHitTestVisible="False" />
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- A radio button cannot be told to be shorter either, and for the same reason as the check box: the Fluent
	     template puts a fixed height on a grid inside itself. Measured at 32 against the 22 of a check box, so it
	     is scaled the same way and with the same numbers, which is what makes the two match.

	     Every radio button in this app has a caption, so nothing uses this directly in a view any more - it is
	     used only from inside RadioButton.Wrap's own Template below, the same way CheckBox.Wrap uses
	     Viewbox.CheckBox. Kept rather than folded into that Template inline, so the two controls keep reading
	     from the one place if the numbers ever need to change. -->
	<Style Selector="Viewbox.RadioButton">
		<Setter Property="Height" Value="22" />
		<Setter Property="StretchDirection" Value="DownOnly" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<Style Selector="Viewbox.RadioButton > RadioButton">
		<Setter Property="FontSize" Value="17.5" />
	</Style>

	<!-- The RadioButton counterpart of CheckBox.Wrap above - same reasoning, same Template shape, same two
	     measured facts: Fluent's own MinHeight survives swapping the Template out and has to be zeroed, and the
	     glyph needs VerticalAlignment="Top" or it centres against the whole wrapped block instead of the first
	     line. The dot is the same small Viewbox.RadioButton every other radio button uses, untouched. -->
	<Style Selector="RadioButton.Wrap">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,*" Background="Transparent">
					<Viewbox Grid.Column="0" Classes="RadioButton" VerticalAlignment="Top" IsHitTestVisible="False">
						<RadioButton IsChecked="{TemplateBinding IsChecked}"
						             IsHitTestVisible="False" Focusable="False" />
					</Viewbox>
					<!-- Top with a 4.5 pixel top margin on the caption, not Center - see the identical note on
					     CheckBox.Wrap above; this one needed the same correction for the same measured reason. -->
					<ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="4,4.5,0,0"
					                  VerticalAlignment="Top" TextBlock.TextWrapping="Wrap" IsHitTestVisible="False" />
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- A Fluent slider is 50 pixels tall and only about 20 of them are the slider: the rest is slack above and
	     below the track. It does not take styling - the sizes are set inside the template, where a local value
	     beats a setter - and a Viewbox cannot help the way it helps a check box, because a Viewbox measures its
	     child unconstrained and a slider asked for its natural width answers 20 pixels, which the box would then
	     stretch twentyfold.

	     What the template does read are these resources, so they are what to set. Given here rather than in the
	     view, because they are the density of the dialog like everything else in this file, and they reach the
	     sliders through the resource chain of the styles that carry them. The horizontal ones only: no view in
	     this app has a vertical slider. -->
	<Style Selector="Slider">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Margin" Value="0,2,0,3" />
	</Style>

	<!-- The event log grid. A row of it is a line of a log, so it gets the type and the height of the rest of the
	     dialog rather than the 32 pixel row Fluent draws.

	     FontSize has to be said here: the DataGrid theme sets it on the cell, and a value from a theme beats the
	     one the dialog would have handed down - measured at 15 against the 12 everything else in the dialog uses,
	     the headers included, which is where the mismatch showed. -->
	<!-- This padding is the whole horizontal inset of a cell, which is what CompactTextColumn is for: the text
	     column of the DataGrid would otherwise add a margin of its own inside it. -->
	<Style Selector="DataGridCell">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="6,2" />
	</Style>

	<Style Selector="DataGridColumnHeader">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="8,4" />
	</Style>

	<!-- Every other row, which the DataGrid of Avalonia has no property for the way the WPF one did. Faint on
	     purpose: it separates the lines without colouring them, which is what the AntiqueWhite of the WPF grid
	     ended up doing. -->
	<Style Selector="DataGridRow:nth-child(2n)">
		<Setter Property="Background" Value="{DynamicResource AlternatingRowBackground}" />
	</Style>
</Styles>
