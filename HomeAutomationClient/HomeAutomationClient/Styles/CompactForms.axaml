<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- The metrics the Fluent slider template reads. A slider is the one control here that cannot be scaled or
	     styled shorter - see the Slider rule below - but it does look these up, so this is where a slider of the
	     size a dense form wants comes from: a 12 pixel high control with a hairline track and a small upright
	     thumb, instead of 50 pixels with a 20 pixel disc. -->
	<Styles.Resources>
		<x:Double x:Key="SliderHorizontalHeight">18</x:Double>

		<!-- Round, so the two are the same number. 14 is the size the dot of a radio button ends up at once its
		     Viewbox has scaled it - 20 at 22 of 32 - which is what makes a slider and a radio button look like
		     they belong to the same form. -->
		<x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
		<x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>

		<x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
		<GridLength x:Key="SliderPreContentMargin">0</GridLength>
		<GridLength x:Key="SliderPostContentMargin">0</GridLength>
	</Styles.Resources>

	<!-- Density for a settings dialog. Fluent sizes its controls for a finger: a 32 pixel high combo box and a 48
	     pixel tab header. The settings views of FroniusMonitor are dense forms of thirty or forty fields, and the
	     ones still to be ported are the big ones, so a dialog that shows them needs the size WPF gives them.

	     Included by the control that wants it, never in App.axaml: the rest of the app is a touch surface and is
	     meant to keep the Fluent sizes. Everything here is a MinHeight and a Padding, so a control that needs more
	     room than the text in it - a wrapping caption, a taller font - still gets it. -->
	<Design.PreviewWith>
		<Border Padding="20" Background="{DynamicResource DialogBackground}">
			<StackPanel Width="260" Spacing="4">
				<TextBox Text="a text box" />
				<ComboBox SelectedIndex="0">
					<ComboBoxItem>a combo box</ComboBoxItem>
				</ComboBox>
				<CheckBox Content="a check box" />
				<Button Content="a button" />
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<!-- Fluent gives a tab header 24 point type and 48 pixels of height, which is a pivot on a phone rather than a
	     tab in a dialog. 16 is what the dialog itself asked for before this file existed. -->
	<!-- The height and the horizontal-only padding are what keep the bar of the selected tab off the caption.
	     The bar is bottom anchored inside the template, with a margin and a height of its own that a style setter
	     cannot change - a value set in a template wins, the same rule as the check box height below - and it sits
	     inside the padding, so padding at the bottom lifts the bar twice as far as it lifts the text and makes
	     matters worse. Only the two together decide it, and measured they decide it like this:

	         clearance = (height - vertical padding - line height) / 2 - 4

	     At 16 point the line height is 18, so 28 pixels with a padding of 2 gave -1: the line box of
	     "Energy flow" ran from 5 to 23 while the bar began at 22, which is what put it through the g and the y.
	     30 pixels with no vertical padding gives 2. -->
	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Padding" Value="10,0" />
	</Style>

	<!-- The padding is horizontal only and the content is centred, so that the number in a box lines up with the
	     caption beside it. Measured: with a padding of 6,1 the text of the box sat 2 pixels above the text of the
	     caption, because the box gives its text a line box of its own inside the padding rather than centring
	     it. -->
	<Style Selector="TextBox">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="6,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="8,1" />
	</Style>

	<!-- The item template of a combo box is not below the combo box in the tree, so it needs a rule of its own. -->
	<Style Selector="ComboBoxItem">
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Padding" Value="8,2" />
	</Style>

	<!-- Buttons keep the height FroniusMonitor gives them, 30 - they are the one thing in a dialog that is aimed
	     at rather than read, so they are not squeezed with the fields.

	     The height comes from the padding and not from a MinHeight, which is not a detail: a MinHeight leaves the
	     content presenter stretched over the spare room, and the caption then draws at the top of it rather than
	     in the middle of the button. Measured, with 12 point type: MinHeight 30 with 2 of padding gives a 24 high
	     text block sitting 3 from the top, 7 of padding gives a 14 high one with 8 above and 8 below. It also
	     means the button follows the type: a bigger font or a caption that wraps still centres. -->
	<Style Selector="Button">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="10,7" />
	</Style>

	<!-- A check box cannot be told to be shorter: the Fluent template puts Height="32" on a grid inside itself,
	     bound to nothing the control exposes, and a style setter loses to a value set in a template. So it is
	     scaled instead - `<Viewbox Classes="CheckBox"><CheckBox ... /></Viewbox>` in the view.

	     A Viewbox scales everything in it, the caption included, so the check box is given a font big enough to
	     land back at the size of the form once it has been scaled down. The two numbers below belong together:
	     change one and the caption no longer matches the rest of the dialog. They were measured, not calculated -
	     the natural height of a check box is not its box but whichever of the box and the caption is taller. -->
	<Style Selector="Viewbox.CheckBox">
		<Setter Property="Height" Value="22" />
		<Setter Property="StretchDirection" Value="DownOnly" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<Style Selector="Viewbox.CheckBox > CheckBox">
		<Setter Property="FontSize" Value="17.5" />
	</Style>

	<!-- A check box with nothing beside it, in a column of its own under a heading. Fluent lays one out 28 wide
	     whether or not it has any content - a box of 20 and a content presenter 8 to its right - so centring the
	     control leaves the box 4 to the left of centre. The 8 is not a resource, unlike the metrics of a slider:
	     it is a margin inside the template, which nothing can style. Taking it off the layout instead leaves the
	     control alone and tells the layout what the box actually occupies, and the box then centres exactly. -->
	<Style Selector="CheckBox.NoContent">
		<Setter Property="Margin" Value="0,0,-8,0" />
	</Style>

	<!-- A radio button cannot be told to be shorter either, and for the same reason as the check box: the Fluent
	     template puts a fixed height on a grid inside itself. Measured at 32 against the 22 of a check box, so it
	     is scaled the same way and with the same numbers, which is what makes the two match. -->
	<Style Selector="Viewbox.RadioButton">
		<Setter Property="Height" Value="22" />
		<Setter Property="StretchDirection" Value="DownOnly" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<Style Selector="Viewbox.RadioButton > RadioButton">
		<Setter Property="FontSize" Value="17.5" />
	</Style>

	<!-- A Fluent slider is 50 pixels tall and only about 20 of them are the slider: the rest is slack above and
	     below the track. It does not take styling - the sizes are set inside the template, where a local value
	     beats a setter - and a Viewbox cannot help the way it helps a check box, because a Viewbox measures its
	     child unconstrained and a slider asked for its natural width answers 20 pixels, which the box would then
	     stretch twentyfold.

	     What the template does read are these resources, so they are what to set. Given here rather than in the
	     view, because they are the density of the dialog like everything else in this file, and they reach the
	     sliders through the resource chain of the styles that carry them. The horizontal ones only: no view in
	     this app has a vertical slider. -->
	<Style Selector="Slider">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Margin" Value="0,2,0,3" />
	</Style>

	<!-- The event log grid. A row of it is a line of a log, so it gets the type and the height of the rest of the
	     dialog rather than the 32 pixel row Fluent draws.

	     FontSize has to be said here: the DataGrid theme sets it on the cell, and a value from a theme beats the
	     one the dialog would have handed down - measured at 15 against the 12 everything else in the dialog uses,
	     the headers included, which is where the mismatch showed. -->
	<!-- This padding is the whole horizontal inset of a cell, which is what CompactTextColumn is for: the text
	     column of the DataGrid would otherwise add a margin of its own inside it. -->
	<Style Selector="DataGridCell">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="6,2" />
	</Style>

	<Style Selector="DataGridColumnHeader">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="8,4" />
	</Style>

	<!-- Every other row, which the DataGrid of Avalonia has no property for the way the WPF one did. Faint on
	     purpose: it separates the lines without colouring them, which is what the AntiqueWhite of the WPF grid
	     ended up doing. -->
	<Style Selector="DataGridRow:nth-child(2n)">
		<Setter Property="Background" Value="{DynamicResource AlternatingRowBackground}" />
	</Style>
</Styles>
