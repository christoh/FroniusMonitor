<ContentControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:i="clr-namespace:De.Hochstaetter.HomeAutomationClient.Assets.Images"
                mc:Ignorable="d" d:DesignWidth="16" d:DesignHeight="16"
                x:Class="De.Hochstaetter.HomeAutomationClient.Assets.Images.CrossIcon">
	<!-- A cross, drawn rather than typed. The character for it, U+2715, is not in Inter, and Inter is the only
	     font the browser head has: the desktop falls back to a system font that has the character, the browser
	     has nothing to fall back to and leaves an empty box in its place. A shape asks no font for anything, so
	     it looks the same on all four heads. -->
	<!-- The stroke follows Foreground, which is an inherited property, so the cross takes the colour of the
	     button it sits in and changes with it when the pointer is over it or the button is disabled. -->
	<Viewbox>
		<Path Width="12" Height="12" Stretch="None" StrokeThickness="1.5" StrokeLineCap="Round"
		      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=i:CrossIcon}}"
		      Data="M 1,1 L 11,11 M 11,1 L 1,11" />
	</Viewbox>
</ContentControl>
