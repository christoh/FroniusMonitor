<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:homeAutomationClient="clr-namespace:De.Hochstaetter.HomeAutomationClient"
             xmlns:c="clr-namespace:De.Hochstaetter.HomeAutomationClient.Controls"
             x:Class="De.Hochstaetter.HomeAutomationClient.App"
             >
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<homeAutomationClient:ViewLocator/>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />
		<!-- The DataGrid brings its own theme, and it is not part of FluentTheme. The event log is the only
		     view that uses the control. -->
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="Styles/Buttons.axaml"/>
		<StyleInclude Source="Styles/HeaderedContentControls.axaml"/>
        <StyleInclude Source="Styles/Controls.axaml"/>
        <StyleInclude Source="Styles/DetailViews.axaml"/>
        <StyleInclude Source="Styles/TextBoxes.axaml"/>
        <!-- After TextBoxes.axaml: the error border has to win over the focused one. -->
        <StyleInclude Source="Styles/Validation.axaml"/>
	</Application.Styles>

	<Application.Resources>
		<ResourceDictionary>
            <!-- AppAccentColor is the accent color of the app, for every platform whose OS has none to offer:
                 iOS, the browser, macOS and Linux. Windows and Android bring their own, and there it is not read
                 at all - see App.SetAccentColor, which also derives the six Fluent shades from it and repeats
                 that whenever the theme variant changes. One value per theme, and this is the only place either
                 of them is written down. -->
			<ResourceDictionary.ThemeDictionaries>
                
                <ResourceDictionary x:Key='Light'>
                    <Color x:Key="AppAccentColor">#FFDA3B01</Color>

                    <!-- The ground of every page (Styles/Controls.axaml), and with it of the group box captions that
                         sit on it. A cool light grey rather than white, so that the white device cards and gauge tiles
                         stand off it - the language of the power flow page. -->
                    <SolidColorBrush x:Key='BackgroundBrush'>#EEF1F5</SolidColorBrush>
					<SolidColorBrush x:Key='ForegroundBrush'>Black</SolidColorBrush>
                    <SolidColorBrush x:Key='DisableBrush'>#80000000</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogBackground">#e8e8e8</SolidColorBrush>

                    <!-- Every other row of the event log. Faint on purpose: it separates the lines without
                         colouring them, which is what the AntiqueWhite of the WPF grid ended up doing. -->
                    <SolidColorBrush x:Key="AlternatingRowBackground">#14000000</SolidColorBrush>

                    <!-- The three kinds of power, written down once for the dashboard (PowerFlow*) and the power flow
                         page (Flow*), which mean the same by them: solar yellow, battery green, grid grey. -->
                    <Color x:Key="SolarColor">#D4A106</Color>
                    <Color x:Key="BatteryColor">#1FA864</Color>
                    <Color x:Key="GridColor">#7D8A9F</Color>

                    <!-- Power Flow -->
                    <SolidColorBrush x:Key="PowerFlowBattery" Color="{StaticResource BatteryColor}" />
                    <SolidColorBrush x:Key="PowerFlowSolar" Color="{StaticResource SolarColor}" />
                    <SolidColorBrush x:Key="PowerFlowGrid" Color="{StaticResource GridColor}" />
                    <SolidColorBrush x:Key="PowerGridIcon" Color="{StaticResource GridColor}" />

                    <!-- Power flow page. Colour is the kind of power, never the device or the direction: solar
                         yellow, battery green, grid grey, everything inside the house blue. Idle is a trace of the
                         ground. The page paints its own ground, the shade a dialog has, which is where the developer
                         approved the light look. -->
                    <SolidColorBrush x:Key="FlowPageBackground">#E8E8E8</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBorder">#CBD3DF</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBorderActive">#9FB0C8</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowText">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowLabel">#5B6B84</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowMuted">#8C99AE</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowSolar" Color="{StaticResource SolarColor}" />
                    <SolidColorBrush x:Key="FlowBattery" Color="{StaticResource BatteryColor}" />
                    <SolidColorBrush x:Key="FlowGrid" Color="{StaticResource GridColor}" />
                    <SolidColorBrush x:Key="FlowHouse">#3B7FE0</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowIdle">#C9D1DE</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowJunction">#6B7A92</SolidColorBrush>
                    
                    <!--Menus-->
                    <SolidColorBrush x:Key='MenuBackground'>#f0f0f0</SolidColorBrush>
                    
                    <!-- Device Control. The tabs of a device card: grey, the selected one a light blue. -->
                    <SolidColorBrush x:Key='DeviceButtonBackground'>#E4E8EE</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceButtonSelectedBackground'>#C9DCF7</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceButtonMouseOver'>#D7E3F4</SolidColorBrush>

                    <!-- The frame of a device card and of a gauge tile of the detail views (Border.DeviceFrame in
                         Styles/Controls.axaml). Rounded and with a gap between the tiles here; the dark variant keeps
                         the square, touching frames it has always had. -->
                    <SolidColorBrush x:Key="DeviceBorder">#C3CCD9</SolidColorBrush>
                    <CornerRadius x:Key="DeviceCornerRadius">6</CornerRadius>
                    <Thickness x:Key="GaugeTileMargin">2</Thickness>

                    <!-- The state of a device. Running is the normal case and therefore the neutral white card; only
                         what needs attention is tinted. Outer is the card, Inner the panel inside it. -->
                    <SolidColorBrush x:Key='DeviceOuterBackgroundRunning'>White</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundFault'>#F5B5B0</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundWarning'>#FBE3A6</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundStartup'>#C3D8F5</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundOther'>#E4E8EE</SolidColorBrush>

                    <SolidColorBrush x:Key='DeviceInnerBackgroundRunning'>#F6F8FB</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundFault'>#FDE7E5</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundWarning'>#FFF6DB</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundStartup'>#E8F0FC</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundOther'>#F1F3F6</SolidColorBrush>
                    <SolidColorBrush x:Key="Lcd">#E3EFE8</SolidColorBrush>
                    <SolidColorBrush x:Key="DeviceCleaning">#E8F0FC</SolidColorBrush>
                    
                    <!-- Toshiba HVAC control: the WPF colours. The hover frame is the same in both variants; the
                         active green, the selected mode and the inactive grey are darkened for the dark one. -->
                    <SolidColorBrush x:Key="HvacModeSelected">Aquamarine</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacActive">LimeGreen</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacInactive">DarkGray</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacOffMark">Red</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacHoverFill">#4000c0ff</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacHoverStroke">#ff00c0ff</SolidColorBrush>
                    <!-- Everything drawn on the Lcd background: text, arrows, house and tree. -->
                    <SolidColorBrush x:Key="HvacLcdForeground">Black</SolidColorBrush>
                    <!-- The Wi-Fi LED keeps this green in the dark variant too, unlike HvacActive. -->
                    <SolidColorBrush x:Key="HvacWifiLedOn">LimeGreen</SolidColorBrush>

                    <!-- Gauge. The needle is the warm orange of the dark variant, so that it is the same accent in
                         both; the units are the labels' slate rather than a link blue. -->
                    <SolidColorBrush x:Key='UnitForeground'>#5B6B84</SolidColorBrush>
                    <SolidColorBrush x:Key='HandFill'>#C54F26</SolidColorBrush>
                    <SolidColorBrush x:Key='TickFill'>#C9D1DE</SolidColorBrush>
                    <SolidColorBrush x:Key='AnimationBackground'>#10000000</SolidColorBrush>

                    <!-- OnOff Button -->
                    <SolidColorBrush x:Key='ThumbFill'>#3B7FE0</SolidColorBrush>
                    <SolidColorBrush x:Key='SliderBackground'>#CBD3DF</SolidColorBrush>

                    <!-- Battery -->
                    <Color x:Key="Soc0">#B42318</Color>
                    <Color x:Key="Soc1">#E5484D</Color>
                    <Color x:Key="Soc2">#F2B705</Color>
                    <Color x:Key="Soc3">#9BCB3C</Color>
                    <Color x:Key="Soc4">#4CC27A</Color>
                    <Color x:Key="Soc5">#1FA864</Color>
                    <SolidColorBrush x:Key="BatteryBorderRunning" Color="{StaticResource BatteryColor}" />
                    <SolidColorBrush x:Key="BatteryBorderFault">Red</SolidColorBrush>
                    <SolidColorBrush x:Key="BatteryBorderWarning">Gold</SolidColorBrush>
                    <!-- Where the frame pulses to while the battery charges, the blue of the WPF animation -->
                    <SolidColorBrush x:Key="BatteryBorderCharging">#FF0088B2</SolidColorBrush>
                    <!-- The empty part above the state of charge, LightGray as in WPF -->
                    <SolidColorBrush x:Key="BatteryBackground">LightGray</SolidColorBrush>

                    <!-- Toast: the same in both variants, white on green reads well either way -->
                    <SolidColorBrush x:Key="ToastBackground">Green</SolidColorBrush>
                    <SolidColorBrush x:Key="ToastForeground">White</SolidColorBrush>

                    <!-- Text boxes. The focused border deliberately does not use the accent colour: the accent of
                         this app is a red and a focused field would read as a field in error. The error colour is
                         a red of its own, and Styles/TextBoxes.axaml lets it win while a field is both. -->
                    <SolidColorBrush x:Key="TextBoxFocusedBorder">#005FB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ValidationErrorBrush">#C42B1C</SolidColorBrush>
                    
                </ResourceDictionary>

                <ResourceDictionary x:Key='Dark'>
                    <Color x:Key="AppAccentColor">#C4480C</Color>

                    <!-- The ground of every page, see the light variant. Black is what Fluent painted a page with
                         before the pages took this brush, so the dark look did not change. -->
                    <SolidColorBrush x:Key='BackgroundBrush'>Black</SolidColorBrush>
					<SolidColorBrush x:Key='ForegroundBrush'>#e8e8e8</SolidColorBrush>
					<SolidColorBrush x:Key='DisableBrush'>#40FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogBackground">#002040</SolidColorBrush>
                    <SolidColorBrush x:Key="AlternatingRowBackground">#18ffffff</SolidColorBrush>

                    <!-- The three kinds of power, see the light variant. The colours of the power flow page's design,
                         which the dashboard took over when the two were made one on the developer's request. -->
                    <Color x:Key="SolarColor">#F5C518</Color>
                    <Color x:Key="BatteryColor">#3ECF8E</Color>
                    <Color x:Key="GridColor">#8B98AE</Color>

                    <!-- Power Flow -->
                    <SolidColorBrush x:Key="PowerFlowBattery" Color="{StaticResource BatteryColor}" />
                    <SolidColorBrush x:Key="PowerFlowSolar" Color="{StaticResource SolarColor}" />
                    <SolidColorBrush x:Key="PowerFlowGrid" Color="{StaticResource GridColor}" />
                    <SolidColorBrush x:Key="PowerGridIcon" Color="{StaticResource GridColor}" />

                    <!-- Power flow page, see the light variant. These are the colours of the design the page was drawn
                         from - a deeper ground than the rest of the app, on purpose and by the developer's choice. -->
                    <SolidColorBrush x:Key="FlowPageBackground">#0A1018</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBackground">#131C2B</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBorder">#23304A</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowCardBorderActive">#2D3D5C</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowText">#E7EDF7</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowLabel">#8B98AE</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowMuted">#5D6B84</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowSolar" Color="{StaticResource SolarColor}" />
                    <SolidColorBrush x:Key="FlowBattery" Color="{StaticResource BatteryColor}" />
                    <SolidColorBrush x:Key="FlowGrid" Color="{StaticResource GridColor}" />
                    <SolidColorBrush x:Key="FlowHouse">#5B9DFF</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowIdle">#2B3752</SolidColorBrush>
                    <SolidColorBrush x:Key="FlowJunction">#AEBBD0</SolidColorBrush>
                    
                    <!--Menus-->
                    <SolidColorBrush x:Key='MenuBackground'>#303030</SolidColorBrush>

                    <!-- Device Control -->
                    <SolidColorBrush x:Key='DeviceButtonBackground'>#005080</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceButtonSelectedBackground'>DarkCyan</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceButtonMouseOver'>CadetBlue</SolidColorBrush>

                    <!-- The frame of a device card and of a gauge tile, see the light variant: square and touching,
                         as the dark look has always been. -->
                    <SolidColorBrush x:Key="DeviceBorder">DimGray</SolidColorBrush>
                    <CornerRadius x:Key="DeviceCornerRadius">0</CornerRadius>
                    <Thickness x:Key="GaugeTileMargin">0</Thickness>
                    
                    <SolidColorBrush x:Key='DeviceOuterBackgroundRunning'>#ff003050</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundFault'>DarkRed</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundWarning'>DarkGoldenrod</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundStartup'>SaddleBrown</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceOuterBackgroundOther'>#ff606060</SolidColorBrush>
                    
                    <SolidColorBrush x:Key='DeviceInnerBackgroundRunning'>#ff101010</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundFault'>#d00000</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundWarning'>DarkOrange</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundStartup'>Brown</SolidColorBrush>
                    <SolidColorBrush x:Key='DeviceInnerBackgroundOther'>#282828</SolidColorBrush>
                    <SolidColorBrush x:Key="Lcd">#335B46</SolidColorBrush>
                    <SolidColorBrush x:Key="DeviceCleaning">Blue</SolidColorBrush>

                    <!-- Toshiba HVAC control, see the light variant -->
                    <SolidColorBrush x:Key="HvacModeSelected">DarkCyan</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacActive">#006400</SolidColorBrush>
                    <!-- Lighter than DeviceOuterBackgroundOther (#606060), on which a switched-off device paints it. -->
                    <SolidColorBrush x:Key="HvacInactive">#A0A0A0</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacOffMark">#FF5C5C</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacHoverFill">#4000c0ff</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacHoverStroke">#ff00c0ff</SolidColorBrush>
                    <!-- Not the near-white ForegroundBrush: on the dark green Lcd the developer wants LightGray. -->
                    <SolidColorBrush x:Key="HvacLcdForeground">LightGray</SolidColorBrush>
                    <SolidColorBrush x:Key="HvacWifiLedOn">LimeGreen</SolidColorBrush>

                    <!-- Gauge -->
                    <SolidColorBrush x:Key='UnitForeground'>Cyan</SolidColorBrush>
                    <SolidColorBrush x:Key='HandFill'>#C54F26</SolidColorBrush>
                    <SolidColorBrush x:Key='TickFill'>#606060</SolidColorBrush>
                    <SolidColorBrush x:Key='AnimationBackground'>#20ffffff</SolidColorBrush>
                    
                    <!-- OnOff Button -->
                    <SolidColorBrush x:Key='ThumbFill'>DarkCyan</SolidColorBrush>
                    <SolidColorBrush x:Key='SliderBackground'>#c54f26</SolidColorBrush>
                    
                    <!-- Battery -->
                    <Color x:Key="Soc0">Red</Color>
                    <Color x:Key="Soc1">DarkRed</Color>
                    <Color x:Key="Soc2">DarkGoldenrod</Color>
                    <Color x:Key="Soc3">Olive</Color>
                    <Color x:Key="Soc4">DarkGreen</Color>
                    <Color x:Key="Soc5">Green</Color>
                    <SolidColorBrush x:Key="BatteryBorderRunning">#ff006080</SolidColorBrush>
                    <SolidColorBrush x:Key="BatteryBorderFault">DarkRed</SolidColorBrush>
                    <SolidColorBrush x:Key="BatteryBorderWarning">Goldenrod</SolidColorBrush>
                    <!-- Brighter than BatteryBorderRunning (#006080), which is already blue here, so the pulse shows -->
                    <SolidColorBrush x:Key="BatteryBorderCharging">#FF00B0E0</SolidColorBrush>
                    <!-- Same as DeviceInnerBackgroundRunning, which the battery used before it got its own key -->
                    <SolidColorBrush x:Key="BatteryBackground">#ff101010</SolidColorBrush>

                    <!-- Toast: the same in both variants, white on green reads well either way -->
                    <SolidColorBrush x:Key="ToastBackground">Green</SolidColorBrush>
                    <SolidColorBrush x:Key="ToastForeground">White</SolidColorBrush>

                    <!-- Text boxes: see the light variant. Both are lightened for a dark ground. -->
                    <SolidColorBrush x:Key="TextBoxFocusedBorder">#4CC2FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ValidationErrorBrush">#FF5C5C</SolidColorBrush>
                    
                </ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<ResourceDictionary.MergedDictionaries>
				<MergeResourceInclude Source="Assets/LoadingIndicators.Avalonia/LoadingIndicators.axaml"/>
				<MergeResourceInclude Source="Styles/Gauges.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>